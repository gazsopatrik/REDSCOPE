# REDSCOPE Environment Configuration Example

# Environment Mode: development / testing / production
ENVIRONMENT=development
DEBUG=True

# API Configuration
PROJECT_NAME=RedScope
API_V1_STR=/api
SECRET_KEY=redscope_super_secret_development_key_change_in_production_32bytes

# Database Configuration (PostgreSQL for prod/docker, SQLite fallback for dev)
POSTGRES_USER=redscope
POSTGRES_PASSWORD=redscope_pass
POSTGRES_DB=redscope_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=sqlite+aiosqlite:///./redscope_dev.db

# Redis & Task Worker
REDIS_URL=redis://localhost:6379/0

# Nmap Scanner Configuration
NMAP_PATH=nmap
NMAP_DEFAULT_TIMEOUT=1800
SCANS_DIR=./scans_raw
REPORTS_DIR=./reports_gen

# Security & Concurrency Limits
MAX_CONCURRENT_SCANS=4
MAX_TARGETS_PER_PROJECT=256
MAX_CIDR_PREFIX=20
SAFE_VALIDATION_REQUIRE_APPROVAL=True
